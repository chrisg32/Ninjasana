# Copy to .env and fill in. The .env file is gitignored.

# A Personal Access Token from https://app.asana.com/0/my-apps
# Without this, Ninjasana runs in offline "demo mode".
ASANA_ACCESS_TOKEN=

# Optional: override the API base URL (defaults to the value below).
# ASANA_BASE_URL=https://app.asana.com/api/1.0
